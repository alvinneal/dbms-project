# copy to .env and edit
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/charter

# signs login tokens; keep it secret and never commit it. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_MINUTES=60

# "development" or "production" (production hides /docs, enables HSTS, requires SECRET_KEY)
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200
# Host headers the API answers to; add your real domain in production
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

MIN_LEAD_MINUTES=30
MAX_ADVANCE_DAYS=365

# abuse protection
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
